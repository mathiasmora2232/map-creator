# Copia este archivo a .env y cambia la contraseña.
POSTGRES_DB=mapcreator
POSTGRES_USER=mapcreator
POSTGRES_PASSWORD=cambia-esta-clave

# Puerto de la app en el host (desarrollo).
PUERTO_APP=8000

# true detrás de HTTPS (perfil «produccion» con Caddy).
OO_COOKIE_SEGURA=false
# false: registro solo por invitación (enlaces que crean los dueños de los mapas o el administrador).
OO_REGISTRO_ABIERTO=true
# Correos de administradores, separados por comas. Vacío: el usuario más antiguo es el administrador.
OO_ADMINS=
# Dirección pública para los enlaces de los correos (p. ej. https://mapas.tudominio.com). Vacía: se deduce de la petición.
OO_URL_PUBLICA=
# Cabecera con la IP real del visitante detrás de un proxy (cf-connecting-ip con Cloudflare). Solo para limitar intentos.
OO_IP_CABECERA=

# Correo (SMTP): verificación de cuentas, recuperar la contraseña, dos pasos e invitaciones. Vacío = desactivado.
# No pongas aquí credenciales reales en el repo: en producción las inyecta el panel desde la bóveda.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OO_MAX_SUBIDA_MB=50
OO_MAX_PROYECTOS=50

# Producción: dominio que sirve Caddy.
DOMINIO=localhost
