# Copia este archivo a .env y cambia la contraseña.
POSTGRES_DB=mapcreator
POSTGRES_USER=mapcreator
POSTGRES_PASSWORD=cambia-esta-clave

# Puerto de la app en el host (desarrollo).
PUERTO_APP=8000

# true detrás de HTTPS (perfil «produccion» con Caddy).
OO_COOKIE_SEGURA=false
# false: registro solo por invitación (enlaces que crean los dueños de los mapas o el administrador).
OO_REGISTRO_ABIERTO=true
# Correos de administradores, separados por comas. Vacío: el usuario más antiguo es el administrador.
OO_ADMINS=
OO_MAX_SUBIDA_MB=50
OO_MAX_PROYECTOS=50

# Producción: dominio que sirve Caddy.
DOMINIO=localhost
